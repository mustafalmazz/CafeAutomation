<Window x:Class="PremiumKafeOtomasyon.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PremiumKafeOtomasyon.Controls"
        Title="Atelier · Kafe Yönetimi" Style="{StaticResource {x:Type Window}}" Width="1480" Height="940" MinWidth="800" MinHeight="600" WindowStartupLocation="CenterScreen" SizeChanged="Window_SizeChanged">
    <Window.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Views/SalesTemplates.xaml"/><ResourceDictionary Source="Views/ManagementTemplates.xaml"/></ResourceDictionary.MergedDictionaries>
        <Visibility x:Key="NavLabelVisibility">Visible</Visibility>
        <Thickness x:Key="NavPadding">16,11</Thickness>

        <controls:EqualConverter x:Key="Equal"/>
        <Style x:Key="Navigation" TargetType="Button" BasedOn="{StaticResource NavButton}"><Setter Property="Padding" Value="{DynamicResource NavPadding}"/><Style.Triggers><DataTrigger Value="True"><DataTrigger.Binding><MultiBinding Converter="{StaticResource Equal}"><Binding Path="Page"/><Binding Path="CommandParameter" RelativeSource="{RelativeSource Self}"/></MultiBinding></DataTrigger.Binding><Setter Property="Background" Value="#4C3A2D"/><Setter Property="Foreground" Value="#F4D7B9"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="NavLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><Setter Property="Margin" Value="13,0,0,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Visibility" Value="{DynamicResource NavLabelVisibility}"/></Style>
        <Style x:Key="NavIcon" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="19"/><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    </ResourceDictionary></Window.Resources>
    <Grid x:Name="RootLayout" Background="{StaticResource Canvas}">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavColumn" Width="188"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="CartColumn" Width="350"/></Grid.ColumnDefinitions>
        <Border Background="#25211E"><Grid Margin="14,24,14,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="9,0,0,35"><Border Width="32" Height="36" Background="#B97B52" CornerRadius="9" DockPanel.Dock="Left" VerticalAlignment="Top"><TextBlock Text="a" FontFamily="Georgia" FontSize="29" FontStyle="Italic" Foreground="#FFF8EB" HorizontalAlignment="Center" Margin="0,-3,0,0"/></Border><StackPanel Margin="10,0,0,0" Visibility="{DynamicResource NavLabelVisibility}"><TextBlock Text="atelier" FontFamily="Georgia" FontSize="27" Foreground="#F9F1E6"/><TextBlock Text="KAFE YÖNETİMİ" Foreground="#968779" FontSize="8" Margin="1,2,0,0"/></StackPanel></DockPanel>
            <StackPanel Grid.Row="1">
                <TextBlock Text="ÇALIŞMA ALANI" Foreground="#867B71" FontSize="9" FontWeight="SemiBold" Margin="15,0,0,13" Visibility="{DynamicResource NavLabelVisibility}"/>
                <Button Style="{StaticResource Navigation}" Command="{Binding NavigateCommand}" CommandParameter="Satış" ToolTip="Satış · F2" AutomationProperties.Name="Satış"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE719;" Style="{StaticResource NavIcon}"/><TextBlock Text="Satış ekranı" Style="{StaticResource NavLabel}"/></StackPanel></Button>
                <Button Style="{StaticResource Navigation}" Command="{Binding NavigateCommand}" CommandParameter="Masalar" ToolTip="Masalar · F3" AutomationProperties.Name="Masalar"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80A;" Style="{StaticResource NavIcon}"/><TextBlock Text="Masalar" Style="{StaticResource NavLabel}"/></StackPanel></Button>
                <Button Style="{StaticResource Navigation}" Command="{Binding NavigateCommand}" CommandParameter="Hazırlık" ToolTip="Hazırlık · F4" AutomationProperties.Name="Hazırlık"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE823;" Style="{StaticResource NavIcon}"/><TextBlock Text="Hazırlık" Style="{StaticResource NavLabel}"/></StackPanel></Button>
                <Border Height="1" Background="#3B342E" Margin="12,23,12,22"/>
                <TextBlock Text="İŞLETME" Foreground="#867B71" FontSize="9" FontWeight="SemiBold" Margin="15,0,0,13" Visibility="{DynamicResource NavLabelVisibility}"/>
                <Button Style="{StaticResource Navigation}" Command="{Binding NavigateCommand}" CommandParameter="Menü" ToolTip="Menü yönetimi" AutomationProperties.Name="Menü"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" Style="{StaticResource NavIcon}"/><TextBlock Text="Menü yönetimi" Style="{StaticResource NavLabel}"/></StackPanel></Button>
                <Button Style="{StaticResource Navigation}" Command="{Binding NavigateCommand}" CommandParameter="Raporlar" ToolTip="Raporlar" AutomationProperties.Name="Raporlar"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D2;" Style="{StaticResource NavIcon}"/><TextBlock Text="Raporlar" Style="{StaticResource NavLabel}"/></StackPanel></Button>
                <Button Style="{StaticResource Navigation}" Command="{Binding NavigateCommand}" CommandParameter="Ayarlar" ToolTip="Ayarlar" AutomationProperties.Name="Ayarlar"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/><TextBlock Text="Ayarlar" Style="{StaticResource NavLabel}"/></StackPanel></Button>
            </StackPanel>
            <StackPanel Grid.Row="3"><Border Background="#302B26" CornerRadius="10" Padding="13" Margin="0,0,0,16" Visibility="{DynamicResource NavLabelVisibility}"><StackPanel><TextBlock Text="Özenle hazırlanmış." FontFamily="Georgia" FontStyle="Italic" FontSize="15" Foreground="#D6C4AF"/><TextBlock Text="Her gün, her fincanda." Foreground="#958779" FontSize="10" Margin="0,6,0,0"/></StackPanel></Border><DockPanel Margin="7,0"><Border Width="34" Height="34" Background="#514236" CornerRadius="17" DockPanel.Dock="Left"><TextBlock Text="AC" Foreground="#ECD6BD" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0" Visibility="{DynamicResource NavLabelVisibility}"><TextBlock Text="İşletme çalışma alanı" Foreground="#E7DDD1" FontSize="10" Margin="0,2,0,0"/><TextBlock Text="Yerel demo" Foreground="#968779" FontSize="10" Margin="0,3,0,0"/></StackPanel></DockPanel></StackPanel>
        </Grid></Border>
        <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="73"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="39"/></Grid.RowDefinitions>
            <Border Background="#FCFBF8" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="26,0"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#EEE9DE" CornerRadius="5" Padding="8,5"><TextBlock Text="DEMO İŞLETME" FontSize="9" FontWeight="SemiBold" Foreground="#7F684C"/></Border><TextBlock Text="{Binding Clock}" Margin="14,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/></StackPanel><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding BusinessName}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding DateLabel}" Style="{StaticResource MutedText}" FontSize="10" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
            <StackPanel Grid.Row="1" Margin="26,25,26,22"><TextBlock Text="{Binding PageTitle}" FontFamily="Georgia" FontSize="29"/><TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
            <ContentControl Grid.Row="2" Content="{Binding}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="ContentTemplate" Value="{StaticResource SalesPage}"/><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="Masalar"><Setter Property="ContentTemplate" Value="{StaticResource TablesPage}"/></DataTrigger><DataTrigger Binding="{Binding Page}" Value="Hazırlık"><Setter Property="ContentTemplate" Value="{StaticResource KitchenPage}"/></DataTrigger><DataTrigger Binding="{Binding Page}" Value="Menü"><Setter Property="ContentTemplate" Value="{StaticResource MenuPage}"/></DataTrigger><DataTrigger Binding="{Binding Page}" Value="Raporlar"><Setter Property="ContentTemplate" Value="{StaticResource ReportsPage}"/></DataTrigger><DataTrigger Binding="{Binding Page}" Value="Ayarlar"><Setter Property="ContentTemplate" Value="{StaticResource SettingsPage}"/></DataTrigger></Style.Triggers></Style></ContentControl.Style></ContentControl>
            <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="26,0" Background="#FAF8F4"><DockPanel VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="#6A8662" Margin="0,0,8,0"/><TextBlock Text="{Binding Notice}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding Notice}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#7B756D"/><Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="#B03D31"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DockPanel></Border>
        </Grid>
        <Border x:Name="CartPanel" Grid.Column="2" Background="#FFFDF9" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="73"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="23,0"><DockPanel VerticalAlignment="Center"><Border DockPanel.Dock="Right" Background="#EAF0E6" Padding="8,5" CornerRadius="5"><TextBlock Text="YEREL KAYIT" FontSize="8" FontWeight="SemiBold" Foreground="#5A7452"/></Border><TextBlock Text="Güncel adisyon" FontWeight="SemiBold" FontSize="14"/></DockPanel></Border>
            <StackPanel Grid.Row="1" Margin="23,24,23,16"><TextBlock Text="{Binding OrderNumber}" Style="{StaticResource Eyebrow}"/><DockPanel Margin="0,8,0,4"><Button DockPanel.Dock="Right" Content="&#xE8AB;" FontFamily="Segoe MDL2 Assets" Padding="0" Width="44" Command="{Binding MoveCommand}" ToolTip="Adisyonu boş masaya taşı" AutomationProperties.Name="Masayı taşı"/><TextBlock Text="{Binding TableName}" FontFamily="Georgia" FontSize="30" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding OrderMeta}" Style="{StaticResource MutedText}" FontSize="11"/><Border Height="1" Background="{StaticResource Line}" Margin="0,19,0,0"/></StackPanel>
            <Grid Grid.Row="2"><ScrollViewer Margin="23,0,14,0"><ItemsControl ItemsSource="{Binding Lines}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,15" Margin="0,0,8,15"><StackPanel><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Total}" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/></DockPanel><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/><DockPanel Margin="0,10,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="−" Style="{StaticResource CounterButton}" Command="{Binding DataContext.MinusCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Bir azalt"/><TextBlock Text="{Binding Quantity}" Width="30" TextAlignment="Center" VerticalAlignment="Center" FontSize="13"/><Button Content="+" Style="{StaticResource CounterButton}" Command="{Binding DataContext.PlusCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Bir artır"/></StackPanel><TextBlock Text="{Binding Status}" FontSize="10" Foreground="#8D7357" VerticalAlignment="Center"/></DockPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasOrder}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Border Background="#F2EDE5" Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center"><TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="25" Foreground="#A28C73" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="İlk lezzeti ekleyin." FontFamily="Georgia" FontSize="21" TextAlignment="Center" Margin="0,18,0,8"/><TextBlock Text="Seçtiğiniz ürünler burada görünecek." Style="{StaticResource MutedText}" FontSize="11" TextAlignment="Center"/></StackPanel>
            </Grid>
            <Border Grid.Row="3" Background="#FBF8F2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="23,17,23,18"><StackPanel><DockPanel Margin="0,0,0,9"><TextBlock Text="Ürünler toplamı" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Subtotal}" TextAlignment="Right" FontSize="12"/></DockPanel><DockPanel Margin="0,0,0,12"><TextBlock Text="Tahsil edilen" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Paid}" TextAlignment="Right" Foreground="{StaticResource Green}" FontSize="12"/></DockPanel><DockPanel Margin="0,0,0,8"><TextBlock Text="Kalan hesap" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="{Binding Remaining}" TextAlignment="Right" FontSize="25" FontWeight="SemiBold"/></DockPanel><TextBlock Text="{Binding CartHint}" FontSize="10" Foreground="#8D8172" TextWrapping="Wrap" Margin="0,0,0,14"/><Button Content="Hazırlığa gönder  →" Command="{Binding SendCommand}" Margin="0,0,0,8" Visibility="{Binding HasDraft, Converter={StaticResource BoolVisibility}}"/><Button Content="Ödeme al   →" Command="{Binding PayCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="Hesap dökümü yazdır" Command="{Binding PrintCommand}" Style="{StaticResource QuietButton}" MinHeight="35" Padding="6" FontSize="10" Margin="0,5,0,0" ToolTip="Mali fiş değildir"/></StackPanel></Border>
        </Grid></Border>
    </Grid>
</Window>

