<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PremiumKafeOtomasyon.Controls">
    <DataTemplate x:Key="MenuPage">
        <Grid Margin="26,0,26,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,20"><Button DockPanel.Dock="Right" Content="+  Yeni ürün" Command="{Binding AddProductCommand}" Style="{StaticResource PrimaryButton}"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="300" AutomationProperties.Name="Menüde ara" ToolTip="Ürün adına göre ara"/></DockPanel>
            <ScrollViewer Grid.Row="1"><StackPanel><ItemsControl ItemsSource="{Binding Products}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Surface}" Padding="14,9" Margin="0,0,0,9"><DockPanel>
                <Button DockPanel.Dock="Right" Content="Düzenle" Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="15,0,0,0"/><TextBlock DockPanel.Dock="Right" Text="{Binding Price}" Width="112" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/><Border DockPanel.Dock="Left" Background="{Binding Color}" CornerRadius="8" Width="68" Height="57" Margin="0,0,16,0"><controls:ProductPhoto PhotoKey="{Binding PhotoKey}" Radius="8"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Category}" Style="{StaticResource MutedText}" Margin="0,5,0,0"/><TextBlock Text="Satışa kapalı" FontSize="10" Foreground="#A44437"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Available}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
            </DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Eşleşen ürün bulunamadı." Visibility="{Binding NoProducts, Converter={StaticResource BoolVisibility}}" Margin="0,20"/></StackPanel></ScrollViewer>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ReportsPage">
        <DataTemplate.Resources>
            <Style x:Key="ReportCard" TargetType="Border"><Setter Property="Background" Value="#FFFDF9"/><Setter Property="BorderBrush" Value="#E6DED2"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="22"/></Style>
            <Style x:Key="ReportLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#8C7761"/></Style>
            <Style x:Key="ReportBar" TargetType="ProgressBar"><Setter Property="Height" Value="6"/><Setter Property="Maximum" Value="100"/><Setter Property="Background" Value="#EEE9E1"/><Setter Property="Foreground" Value="#AE7652"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid ClipToBounds="True"><Border Background="{TemplateBinding Background}" CornerRadius="3"/><Border x:Name="PART_Track"/><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
        </DataTemplate.Resources>
        <ScrollViewer Margin="26,0,26,0" HorizontalScrollBarVisibility="Disabled"><StackPanel>
            <DockPanel Margin="0,0,0,18">
                <Button DockPanel.Dock="Right" Content="Raporu dışa aktar ↗" Command="{Binding ExportCommand}" VerticalAlignment="Center" Padding="16,10" ToolTip="Seçilen dönemin adisyonlarını CSV olarak kaydet"/>
                <StackPanel VerticalAlignment="Center"><WrapPanel Margin="0,0,0,12"><ComboBox ItemsSource="{Binding ReportPeriods}" SelectedItem="{Binding ReportPeriod}" Width="130" Margin="0,0,10,6" AutomationProperties.Name="Rapor dönemi"/><DatePicker SelectedDate="{Binding ReportDate}" Width="145" Margin="0,0,0,6" AutomationProperties.Name="Rapor tarihi" ToolTip="Görüntülenecek gün, hafta, ay veya yıl içinden bir tarih seçin"/></WrapPanel><TextBlock Text="DÖNEM PERFORMANSI" Style="{StaticResource ReportLabel}"/><TextBlock Text="{Binding ReportRangeLabel}" FontSize="12" Margin="0,5,0,0" Foreground="{StaticResource Muted}"/></StackPanel>
            </DockPanel>
            <DockPanel Margin="0,0,0,14"><Button DockPanel.Dock="Right" Content="Tarih aralığı &amp; maliyet analizi ↗" Command="{Binding OperationsCommand}" CommandParameter="İleri raporlar"/><StackPanel VerticalAlignment="Center"><TextBlock Text="DÖNEMDEKİ İADELER" Style="{StaticResource ReportLabel}"/><TextBlock Text="{Binding Refunded}" FontSize="18" Foreground="#91613E" Margin="0,5,0,0"/></StackPanel></DockPanel><Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border CornerRadius="16" Padding="22" Margin="0,0,12,0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#302920" Offset="0"/><GradientStop Color="#554031" Offset="1"/></LinearGradientBrush></Border.Background><StackPanel>
                    <TextBlock Text="KAPANAN HESAP SATIŞI" Foreground="#D2B797" FontSize="10" FontWeight="SemiBold"/>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="43" Margin="0,15,0,12"><TextBlock Text="{Binding Revenue}" FontSize="34" Foreground="#FFF8ED" FontWeight="SemiBold"/></Viewbox>
                    <Border BorderBrush="#76604C" BorderThickness="0,1,0,0" Padding="0,12,0,0"><TextBlock Text="{Binding ClosedCount, StringFormat={}{0} tamamlanan adisyon}" Foreground="#DBC7B1" FontSize="11" TextWrapping="Wrap"/></Border>
                </StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource ReportCard}" Margin="0,0,12,0"><StackPanel><TextBlock Text="DÖNEM TAHSİLATI" Style="{StaticResource ReportLabel}"/><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="43" Margin="0,15,0,12"><TextBlock Text="{Binding Collected}" FontSize="30" FontWeight="SemiBold" Foreground="#526A50"/></Viewbox><TextBlock Text="Kısmi ödemeler dahil" FontSize="11" Style="{StaticResource MutedText}" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource ReportCard}"><StackPanel><TextBlock Text="ORTALAMA HESAP" Style="{StaticResource ReportLabel}"/><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="43" Margin="0,15,0,12"><TextBlock Text="{Binding Average}" FontSize="30" FontWeight="SemiBold"/></Viewbox><TextBlock Text="Tamamlanan adisyon başına" FontSize="11" Style="{StaticResource MutedText}" TextWrapping="Wrap"/></StackPanel></Border>
            </Grid>
            <Border Style="{StaticResource ReportCard}" Margin="0,0,0,18"><StackPanel><TextBlock Text="{Binding YearlyRevenueLabel}" Style="{StaticResource ReportLabel}"/><TextBlock Text="{Binding YearlyRevenue}" FontSize="30" FontWeight="SemiBold" Foreground="#91613E" Margin="0,8,0,8"/><TextBlock Text="Seçilen takvim yılında tamamlanan adisyonlar · İndirim sonrası, iadeler düşülmeden" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border>
            <TextBlock Text="Seçilen tarihin öne çıkan ürünleri" FontFamily="Georgia" FontSize="22" Margin="0,0,0,8"/>
            <TextBlock Text="Tamamlanan adisyonlardaki satış adedine göre · İptal ve ikram hariç. Eşitlikte ürün adı sırası kullanılır. Tutar bazlı iadeler ürün adedinden düşülmez." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <ItemsControl ItemsSource="{Binding ProductHighlights}" Margin="0,0,0,18"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource ReportCard}" Width="260" MinHeight="158" Margin="0,0,12,12"><StackPanel><TextBlock Text="{Binding Title}" Style="{StaticResource ReportLabel}"/><TextBlock Text="{Binding Range}" Style="{StaticResource MutedText}" FontSize="10" Margin="0,6,0,16"/><TextBlock Text="{Binding Name}" FontSize="20" FontFamily="Georgia" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Foreground="#526A50" FontSize="12" Margin="0,10,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource ReportCard}" Margin="0,0,12,0"><StackPanel>
                    <TextBlock Text="TAHSİLAT ANALİZİ" Style="{StaticResource ReportLabel}"/><TextBlock Text="Ödeme dağılımı" FontFamily="Georgia" FontSize="23" Margin="0,6,0,22"/>
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Cash}" FontWeight="SemiBold"/><TextBlock Text="Nakit" FontSize="12"/></DockPanel><ProgressBar Value="{Binding CashShare, Mode=OneWay}" Style="{StaticResource ReportBar}" Foreground="#73856A" Margin="0,10,0,6"/><TextBlock Text="{Binding CashShare, StringFormat={}{0:0.#}%}" Style="{StaticResource MutedText}" FontSize="10" Margin="0,0,0,17"/>
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Card}" FontWeight="SemiBold"/><TextBlock Text="Kart kaydı" FontSize="12"/></DockPanel><ProgressBar Value="{Binding CardShare, Mode=OneWay}" Style="{StaticResource ReportBar}" Margin="0,10,0,6"/><TextBlock Text="{Binding CardShare, StringFormat={}{0:0.#}%}" Style="{StaticResource MutedText}" FontSize="10" Margin="0,0,0,17"/>
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Other}" FontWeight="SemiBold"/><TextBlock Text="Diğer" FontSize="12"/></DockPanel><ProgressBar Value="{Binding OtherShare, Mode=OneWay}" Style="{StaticResource ReportBar}" Foreground="#9F9485" Margin="0,10,0,6"/><TextBlock Text="{Binding OtherShare, StringFormat={}{0:0.#}%}" Style="{StaticResource MutedText}" FontSize="10"/>
                    <TextBlock Text="Seçilen dönemde kaydedilen tahsilatların yöntemlere göre payı." Style="{StaticResource MutedText}" FontSize="10" TextWrapping="Wrap" Margin="0,20,0,0"/>
                </StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource ReportCard}"><StackPanel>
                    <TextBlock Text="MENÜ PERFORMANSI" Style="{StaticResource ReportLabel}"/><TextBlock Text="Dönemin favorileri" FontFamily="Georgia" FontSize="23" Margin="0,6,0,6"/><TextBlock Text="Tamamlanan adisyonlardaki ürün satışları" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,18"/>
                    <ItemsControl ItemsSource="{Binding Ranking}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#EEE8DF" BorderThickness="0,0,0,1" Padding="0,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Quantity, StringFormat={}{0} adet satıldı}" Style="{StaticResource MutedText}" FontSize="10" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Total}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Foreground="#91613E"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <Border Background="#F5F1E9" CornerRadius="12" Padding="22,30" Margin="0,8,0,0" Visibility="{Binding NoSales, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="#AD9273" Margin="0,0,0,16"/><TextBlock Text="İlk satışla şekillenecek." FontFamily="Georgia" FontSize="18" TextWrapping="Wrap"/><TextBlock Text="Hesaplar tamamlandıkça en çok gelir getiren ürünler burada sıralanır." Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="11" Margin="0,9,0,0"/></StackPanel></Border>
                </StackPanel></Border>
            </Grid>
            <Border Style="{StaticResource ReportCard}" Margin="0,0,0,22"><StackPanel>
                <DockPanel Margin="0,0,0,20"><Border DockPanel.Dock="Right" Background="#EEEADF" CornerRadius="6" Padding="10,6"><TextBlock Text="{Binding ClosedCount, StringFormat={}{0} adisyon}" FontSize="10" Foreground="#7A6853"/></Border><StackPanel><TextBlock Text="İŞLEM DÖKÜMÜ" Style="{StaticResource ReportLabel}"/><TextBlock Text="Tamamlanan adisyonlar" FontFamily="Georgia" FontSize="22" Margin="0,6,0,0"/></StackPanel></DockPanel>
                <Border Background="#F3EFE8" CornerRadius="6" Padding="12,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="ADİSYON" Style="{StaticResource ReportLabel}"/><TextBlock Grid.Column="1" Text="MASA" Style="{StaticResource ReportLabel}"/><TextBlock Grid.Column="2" Text="TARİH / SAAT" Style="{StaticResource ReportLabel}"/><TextBlock Grid.Column="3" Text="YÖNTEM" Style="{StaticResource ReportLabel}"/><TextBlock Grid.Column="4" Text="TOPLAM" TextAlignment="Right" Style="{StaticResource ReportLabel}"/></Grid></Border>
                <ItemsControl ItemsSource="{Binding Sales}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#EEE8DF" BorderThickness="0,0,0,1" Padding="12,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Number}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Table}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding Time}" TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="3" Text="{Binding Methods}" TextWrapping="Wrap" FontSize="11"/><TextBlock Grid.Column="4" Text="{Binding Total}" FontWeight="SemiBold" TextAlignment="Right" TextWrapping="Wrap"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Text="Seçilen dönemde kapanan hesap yok." Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,26" Visibility="{Binding NoSales, Converter={StaticResource BoolVisibility}}"/>
            </StackPanel></Border>
        </StackPanel></ScrollViewer>
    </DataTemplate>
    <DataTemplate x:Key="SettingsPage">
        <ScrollViewer Margin="26,0,26,0"><StackPanel>
            <Border Style="{StaticResource Surface}" Margin="0,0,0,18"><StackPanel><TextBlock Text="İşletme çalışma alanı" Style="{StaticResource SectionTitle}"/><WrapPanel Margin="0,18,0,0"><Button Content="QR menü &amp; istekler ↗" Command="{Binding OperationsCommand}" CommandParameter="QR menü &amp; istekler" Margin="0,0,10,10" Padding="16,12"/><Button Content="Personel ↗" Command="{Binding OperationsCommand}" CommandParameter="Personel" Margin="0,0,10,10" Padding="16,12"/><Button Content="Kasa &amp; vardiya ↗" Command="{Binding OperationsCommand}" CommandParameter="Kasa &amp; vardiya" Margin="0,0,10,10" Padding="16,12"/><Button Content="Adisyon işlemleri ↗" Command="{Binding OperationsCommand}" CommandParameter="Adisyon işlemleri" Margin="0,0,10,10" Padding="16,12"/><Button Content="Stok &amp; reçete ↗" Command="{Binding OperationsCommand}" CommandParameter="Stok &amp; reçete" Margin="0,0,10,10" Padding="16,12"/><Button Content="Müşteri &amp; sadakat ↗" Command="{Binding OperationsCommand}" CommandParameter="Müşteri &amp; sadakat" Margin="0,0,10,10" Padding="16,12"/><Button Content="Kampanyalar ↗" Command="{Binding OperationsCommand}" CommandParameter="Kampanyalar" Margin="0,0,10,10" Padding="16,12"/><Button Content="İleri raporlar ↗" Command="{Binding OperationsCommand}" CommandParameter="İleri raporlar" Margin="0,0,10,10" Padding="16,12"/><Button Content="Yedek &amp; cihazlar ↗" Command="{Binding OperationsCommand}" CommandParameter="Yedek &amp; cihazlar" Margin="0,0,10,10" Padding="16,12"/></WrapPanel><TextBlock Text="İşletme kimliği" Style="{StaticResource SectionTitle}" Margin="0,16,0,0"/><TextBlock Text="İşletme adı" Style="{StaticResource MutedText}" Margin="0,20,0,7"/><TextBox Text="{Binding BusinessDraft, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" AutomationProperties.Name="İşletme adı"/><Button Content="Değişiklikleri kaydet" Command="{Binding SaveBusinessCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Surface}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Kayıtlar ve yedekleme" Style="{StaticResource SectionTitle}"/><TextBlock Text="İşletme verileri SQL Server tablolarında, işlem bütünlüğü korunarak kaydedilir. Taşınabilir dış yedek veya SQL .bak yedeği alınabilir." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,10"/><TextBlock Text="{Binding DataPath}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource Accent}"/><Button Content="Yedek kopyası kaydet ↗" Command="{Binding BackupCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Surface}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Cihazlar ve çalışma kapsamı" Style="{StaticResource SectionTitle}"/><Button Content="POS ayarları ve test merkezi ↗" Command="{Binding PosCommand}" HorizontalAlignment="Left" Margin="0,16,0,8" Style="{StaticResource PrimaryButton}"/><TextBlock Text="Windows masaüstü ve dokunmatik POS · En az 800 × 600 kullanılabilir ekran alanı (DIP). Arayüz Windows ölçeklendirmesine uyum sağlar." TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,14,0,10"/><TextBlock Text="F2 Satış   ·   F3 Masalar   ·   F4 Hazırlık   ·   Ctrl+F Ürün ara   ·   F9 Tahsilat" TextWrapping="Wrap" FontSize="12"/><TextBlock Text="Yazdırma, Windows yazdırma penceresiyle hesap dökümü üretir. Mali fiş/ÖKC, banka POS'u, çoklu cihaz, Android/iPad ve bulut bağlantıları bu sürümde bulunmaz." TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,14,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Surface}" Margin="0,0,0,20"><StackPanel><TextBlock Text="Son işlemler" Style="{StaticResource SectionTitle}" Margin="0,0,0,15"/><ItemsControl ItemsSource="{Binding Activity}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,0,0,12"><TextBlock DockPanel.Dock="Left" Text="{Binding At, StringFormat={}{0:HH:mm}}" Width="58" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        </StackPanel></ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
