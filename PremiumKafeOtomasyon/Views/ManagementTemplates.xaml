<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PremiumKafeOtomasyon.Controls">
    <DataTemplate x:Key="MenuPage">
        <Grid Margin="26,0,26,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,20"><Button DockPanel.Dock="Right" Content="+  Yeni ürün" Command="{Binding AddProductCommand}" Style="{StaticResource PrimaryButton}"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="300" AutomationProperties.Name="Menüde ara" ToolTip="Ürün adına göre ara"/></DockPanel>
            <ScrollViewer Grid.Row="1"><StackPanel><ItemsControl ItemsSource="{Binding Products}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Surface}" Padding="14,9" Margin="0,0,0,9"><DockPanel>
                <Button DockPanel.Dock="Right" Content="Düzenle" Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="15,0,0,0"/><TextBlock DockPanel.Dock="Right" Text="{Binding Price}" Width="112" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/><Border DockPanel.Dock="Left" Background="{Binding Color}" CornerRadius="8" Width="68" Height="57" Margin="0,0,16,0"><controls:ProductIllustration Kind="{Binding Art}"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Category}" Style="{StaticResource MutedText}" Margin="0,5,0,0"/><TextBlock Text="Satışa kapalı" FontSize="10" Foreground="#A44437"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Available}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
            </DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Eşleşen ürün bulunamadı." Visibility="{Binding NoProducts, Converter={StaticResource BoolVisibility}}" Margin="0,20"/></StackPanel></ScrollViewer>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ReportsPage">
        <ScrollViewer Margin="26,0,26,0"><StackPanel>
            <DockPanel Margin="0,0,0,20"><Button DockPanel.Dock="Right" Content="CSV dışa aktar ↗" Command="{Binding ExportCommand}"/><TextBlock Text="Bugün · Yerel saat" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></DockPanel>
            <UniformGrid Columns="3"><Border Style="{StaticResource Surface}" Margin="0,0,12,0"><StackPanel><TextBlock Text="KAPANAN HESAP SATIŞI" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Revenue}" FontSize="27" Margin="0,12,0,7"/><TextBlock Text="Tamamlanan adisyonların toplamı" Style="{StaticResource MutedText}" FontSize="10"/></StackPanel></Border><Border Style="{StaticResource Surface}" Margin="0,0,12,0"><StackPanel><TextBlock Text="BUGÜNKÜ TAHSİLAT" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Collected}" FontSize="27" Margin="0,12,0,7"/><TextBlock Text="Kısmi ödemeler dahil" Style="{StaticResource MutedText}" FontSize="10"/></StackPanel></Border><Border Style="{StaticResource Surface}"><StackPanel><TextBlock Text="ORTALAMA HESAP" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Average}" FontSize="27" Margin="0,12,0,7"/><TextBlock Text="{Binding ClosedCount, StringFormat={}{0} tamamlanan adisyon}" Style="{StaticResource MutedText}" FontSize="10"/></StackPanel></Border></UniformGrid>
            <Grid Margin="0,20,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Surface}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Tahsilat dağılımı" Style="{StaticResource SectionTitle}" Margin="0,0,0,20"/><DockPanel Margin="0,0,0,15"><TextBlock Text="Nakit"/><TextBlock Text="{Binding Cash}" TextAlignment="Right" FontWeight="SemiBold"/></DockPanel><DockPanel Margin="0,0,0,15"><TextBlock Text="Kart kaydı"/><TextBlock Text="{Binding Card}" TextAlignment="Right" FontWeight="SemiBold"/></DockPanel><DockPanel><TextBlock Text="Diğer"/><TextBlock Text="{Binding Other}" TextAlignment="Right" FontWeight="SemiBold"/></DockPanel><TextBlock Text="Kart işlemleri tahsilat kaydıdır; banka POS bağlantısı yoktur." TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="10" Margin="0,22,0,0"/></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource Surface}"><StackPanel><TextBlock Text="Öne çıkan ürünler" Style="{StaticResource SectionTitle}" Margin="0,0,0,17"/><ItemsControl ItemsSource="{Binding Ranking}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,15"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Total}" FontSize="11"/><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel><Border HorizontalAlignment="Left" Background="#B98962" Height="4" Width="{Binding BarWidth}" CornerRadius="2" Margin="0,8,0,4"/><TextBlock Text="{Binding Quantity, StringFormat={}{0} adet}" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="İlk hesabınızı kapattığınızda ürün satışları burada görünecek." TextWrapping="Wrap" Style="{StaticResource MutedText}" Visibility="{Binding NoSales, Converter={StaticResource BoolVisibility}}"/></StackPanel></Border>
            </Grid>
            <Border Style="{StaticResource Surface}" Margin="0,0,0,20"><StackPanel><TextBlock Text="Tamamlanan adisyonlar" Style="{StaticResource SectionTitle}" Margin="0,0,0,18"/><ItemsControl ItemsSource="{Binding Sales}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="1.5*"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Number}"/><TextBlock Grid.Column="1" Text="{Binding Table}"/><TextBlock Grid.Column="2" Text="{Binding Time}" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="3" Text="{Binding Methods}"/><TextBlock Grid.Column="4" Text="{Binding Total}" FontWeight="SemiBold" TextAlignment="Right"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Bugün henüz kapanan hesap yok." Style="{StaticResource MutedText}" Visibility="{Binding NoSales, Converter={StaticResource BoolVisibility}}"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
    </DataTemplate>
    <DataTemplate x:Key="SettingsPage">
        <ScrollViewer Margin="26,0,26,0"><StackPanel>
            <Border Style="{StaticResource Surface}" Margin="0,0,0,18"><StackPanel><TextBlock Text="İşletme kimliği" Style="{StaticResource SectionTitle}"/><TextBlock Text="İşletme adı" Style="{StaticResource MutedText}" Margin="0,20,0,7"/><TextBox Text="{Binding BusinessDraft, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" AutomationProperties.Name="İşletme adı"/><Button Content="Değişiklikleri kaydet" Command="{Binding SaveBusinessCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Surface}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Kayıtlar ve yedekleme" Style="{StaticResource SectionTitle}"/><TextBlock Text="Değişiklikler bu bilgisayara kaydedilir. Her kayıtta önceki dosyanın bir yedeği korunur." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,10"/><TextBlock Text="{Binding DataPath}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource Accent}"/><Button Content="Yedek kopyası kaydet ↗" Command="{Binding BackupCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Surface}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Cihazlar ve çalışma kapsamı" Style="{StaticResource SectionTitle}"/><TextBlock Text="Windows masaüstü ve dokunmatik POS · En az 800 × 600 kullanılabilir ekran alanı (DIP). Arayüz Windows ölçeklendirmesine uyum sağlar." TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,14,0,10"/><TextBlock Text="F2 Satış   ·   F3 Masalar   ·   F4 Hazırlık   ·   Ctrl+F Ürün ara   ·   F9 Tahsilat" TextWrapping="Wrap" FontSize="12"/><TextBlock Text="Yazdırma, Windows yazdırma penceresiyle hesap dökümü üretir. Mali fiş/ÖKC, banka POS'u, çoklu cihaz, Android/iPad ve bulut bağlantıları bu sürümde bulunmaz." TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,14,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Surface}" Margin="0,0,0,20"><StackPanel><TextBlock Text="Son işlemler" Style="{StaticResource SectionTitle}" Margin="0,0,0,15"/><ItemsControl ItemsSource="{Binding Activity}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,0,0,12"><TextBlock DockPanel.Dock="Left" Text="{Binding At, StringFormat={}{0:HH:mm}}" Width="58" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        </StackPanel></ScrollViewer>
    </DataTemplate>
</ResourceDictionary>

