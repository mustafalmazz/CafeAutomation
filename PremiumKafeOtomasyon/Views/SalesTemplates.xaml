<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PremiumKafeOtomasyon.Controls">
    <DataTemplate x:Key="ProductCard">
        <Button Margin="0,0,0,16" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Command="{Binding DataContext.ProductCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" IsEnabled="{Binding Available}" AutomationProperties.Name="{Binding Name}">
            <StackPanel><Border Background="{Binding Color}" CornerRadius="9,9,0,0" Margin="1,1,1,0" ClipToBounds="True"><Border.Style><Style TargetType="Border"><Setter Property="Height" Value="143"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.ShortViewport, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Height" Value="96"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Ellipse Width="134" Height="134" Fill="#22FFFFFF" HorizontalAlignment="Right" Margin="0,-30,-30,0"/><controls:ProductIllustration Kind="{Binding Art}" Margin="9,9,9,0"/><Border Background="#DFFFFFFF" CornerRadius="4" Padding="7,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"><TextBlock Text="{Binding Badge}" FontSize="8" FontWeight="SemiBold" Foreground="#645747"/></Border></Grid></Border>
                <StackPanel Margin="14,13,14,12"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" FontSize="10" Margin="0,5,0,12" TextTrimming="CharacterEllipsis"/><DockPanel><Border DockPanel.Dock="Right" Background="#F4EEE6" CornerRadius="7" Width="29" Height="29"><TextBlock Text="+" FontSize="20" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{Binding Price}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/></DockPanel></StackPanel>
            </StackPanel>
        </Button>
    </DataTemplate>
    <DataTemplate x:Key="SalesPage">
        <Grid Margin="26,0,12,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="#EDE5D8" CornerRadius="12" Margin="0,0,14,20" Height="104" ClipToBounds="True"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding ShortViewport}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><StackPanel Margin="20,18" VerticalAlignment="Center"><TextBlock Text="HER FİNCANDA BİR HİKÂYE" FontSize="8" FontWeight="SemiBold" Foreground="#8D6C4A"/><TextBlock Text="Günün ritmini yakalayın." FontFamily="Georgia" FontSize="23" Margin="0,6,0,0"/><TextBlock Text="Taze kahveler, sıcak karşılamalar." FontSize="11" Foreground="#897661" Margin="0,6,0,0"/></StackPanel><controls:ProductIllustration Kind="coffee" Width="166" Height="118" HorizontalAlignment="Right" Margin="0,0,10,-15" Opacity="0.95"/></Grid></Border>
            <Grid Grid.Row="1" Margin="0,0,14,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="38,11,12,11" AutomationProperties.Name="Ürün ara" Tag="ProductSearch"/><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#8B8175" IsHitTestVisible="False"/><TextBlock Text="Ürün veya içerik ara..." Margin="39,0,0,0" VerticalAlignment="Center" Foreground="#9B9389" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><Button Grid.Column="1" Content="Masa seç ↗" Command="{Binding NavigateCommand}" CommandParameter="Masalar" Margin="10,0,0,0"/></Grid>
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" Margin="0,0,14,17"><ItemsControl ItemsSource="{Binding Categories}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.CategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,7,0" Padding="13,9" MinHeight="44"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Selected}" Value="True"><Setter Property="Background" Value="#302A24"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#302A24"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11"/><TextBlock Text="{Binding Count}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Opacity="0.55" FontSize="10" Margin="7,1,0,0"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
            <ScrollViewer Grid.Row="3"><StackPanel><DockPanel Margin="0,0,16,15"><TextBlock DockPanel.Dock="Right" Text="{Binding ProductCount}" Style="{StaticResource MutedText}" FontSize="10" VerticalAlignment="Center"/><TextBlock Text="{Binding SelectedCategory}" FontWeight="SemiBold" FontSize="14"/></DockPanel><ItemsControl ItemsSource="{Binding Products}" ItemTemplate="{StaticResource ProductCard}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:AdaptiveTilePanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl><Border Style="{StaticResource Surface}" Margin="0,0,14,16" Visibility="{Binding NoProducts, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="Aradığınız lezzet bulunamadı." Style="{StaticResource SectionTitle}"/><TextBlock Text="Aramayı değiştirin veya başka bir kategori seçin." Margin="0,9,0,0" TextWrapping="Wrap" Style="{StaticResource MutedText}"/></StackPanel></Border></StackPanel></ScrollViewer>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="TablesPage">
        <Grid Margin="26,0,12,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <UniformGrid Columns="3" Margin="0,0,14,22"><Border Style="{StaticResource Surface}" Margin="0,0,12,0"><StackPanel><TextBlock Text="AÇIK MASA" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding OccupiedTables}" FontSize="30" Margin="0,7,0,0"/></StackPanel></Border><Border Style="{StaticResource Surface}" Margin="0,0,12,0"><StackPanel><TextBlock Text="MÜSAİT MASA" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding EmptyTables}" FontSize="30" Foreground="{StaticResource Green}" Margin="0,7,0,0"/></StackPanel></Border><Border Style="{StaticResource Surface}"><StackPanel><TextBlock Text="AÇIK HESAPLAR" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding OpenTotal}" FontSize="25" Margin="0,11,0,0"/></StackPanel></Border></UniformGrid>
            <DockPanel Grid.Row="1" Margin="0,0,14,20"><ComboBox DockPanel.Dock="Right" Width="165" ItemsSource="{Binding Areas}" SelectedItem="{Binding Area}" AutomationProperties.Name="Masa alanı"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Masa planı" Style="{StaticResource SectionTitle}"/><TextBlock Text="Sipariş almak için bir masa seçin." Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel></DockPanel>
            <ScrollViewer Grid.Row="2"><ItemsControl ItemsSource="{Binding Tables}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                <Button Width="218" Margin="0,0,16,16" Padding="18" Command="{Binding DataContext.SelectTableCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Name}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Selected}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="Background" Value="#FCF8F2"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel>
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Seats}" Style="{StaticResource MutedText}" FontSize="10"/><TextBlock Text="{Binding Area}" Style="{StaticResource Eyebrow}"/></DockPanel>
                    <Grid Height="93" Margin="0,6,0,6"><Border Width="62" Height="48" CornerRadius="10" Background="#F2EDE5" BorderBrush="#DBD2C5" BorderThickness="1"><TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border Width="30" Height="5" Background="#D6C7B5" CornerRadius="2" VerticalAlignment="Top" Margin="0,14,0,0"/><Border Width="30" Height="5" Background="#D6C7B5" CornerRadius="2" VerticalAlignment="Bottom" Margin="0,0,0,14"/><Border Width="5" Height="26" Background="#D6C7B5" CornerRadius="2" HorizontalAlignment="Left" Margin="50,0,0,0"/><Border Width="5" Height="26" Background="#D6C7B5" CornerRadius="2" HorizontalAlignment="Right" Margin="0,0,50,0"/></Grid>
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Amount}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" FontSize="11" Foreground="{Binding StatusColor}" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding Time}" Style="{StaticResource MutedText}" FontSize="10" Margin="0,9,0,0"/>
                </StackPanel></Button>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="KitchenPage">
        <ScrollViewer Margin="26,0,12,0"><StackPanel><Border Background="#ECEFE6" CornerRadius="10" Padding="17" Margin="0,0,14,20"><TextBlock Text="Bar + Mutfak  ·  Yeni siparişleri hazırlayın, hazır ürünleri servise aktarın." Foreground="#5B6D50" FontSize="12" TextWrapping="Wrap"/></Border><ItemsControl ItemsSource="{Binding Kitchen}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Surface}" Width="288" Margin="0,0,16,16" Padding="20"><StackPanel>
            <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Number}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Table}" Style="{StaticResource SectionTitle}"/></DockPanel><TextBlock Text="{Binding Time}" Style="{StaticResource MutedText}" Margin="0,5,0,15"/><Border Background="{Binding StatusBackground}" CornerRadius="5" Padding="9,6" HorizontalAlignment="Left"><TextBlock Text="{Binding Status}" FontSize="11" Foreground="{Binding StatusColor}"/></Border>
            <ItemsControl ItemsSource="{Binding Lines}" Margin="0,15,0,15"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,10"><StackPanel><DockPanel><TextBlock DockPanel.Dock="Left" Text="{Binding Quantity, StringFormat={}{0} ×}" FontWeight="SemiBold" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/></DockPanel><TextBlock Text="{Binding Options}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding Note}" Foreground="{StaticResource Accent}" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="{Binding Station}" FontSize="9" Foreground="#8C8278" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Button Content="{Binding NextAction}" Command="{Binding DataContext.AdvanceKitchenCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource PrimaryButton}" FontSize="12"/>
        </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Border Style="{StaticResource Surface}" Margin="0,0,14,0" Visibility="{Binding NoKitchen, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="Her şey yetişti." FontFamily="Georgia" FontSize="26"/><TextBlock Text="Hazırlık bekleyen sipariş yok. Yeni siparişler burada görünecek." Style="{StaticResource MutedText}" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></Border></StackPanel></ScrollViewer>
    </DataTemplate>
</ResourceDictionary>



